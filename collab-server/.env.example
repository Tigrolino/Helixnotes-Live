# Local dev only - Render sets PORT itself and env vars come from its dashboard, not this file.
PORT=8787

# Shared workspace secret. Must match the "Collaboration password" set in HelixNotes's
# Settings -> Collaboration tab. Generate a real one for anything beyond local testing, e.g.:
#   openssl rand -base64 24
COLLAB_PASSWORD=12345678

# --- File/image uploads (optional) ---

# Max size of one uploaded file, in bytes. Defaults to 95 MB (95 * 1024 * 1024) if unset.
# UPLOAD_MAX_BYTES=99614720

# Where uploaded files are saved on this server's own disk. Relative paths resolve against the
# process's working directory. This disk is NOT durable on Render's free/starter plan - it's
# wiped on every redeploy/restart - so uploads only survive long-term if GITHUB_TOKEN/GITHUB_REPO
# below are also set.
# UPLOADS_DIR=uploads

# --- Live document persistence (optional tuning - sensible defaults if left unset) ---

# Where each workspace's live-document snapshot is saved on this server's own disk, same
# durability caveat as UPLOADS_DIR above.
# DOC_SNAPSHOTS_DIR=doc-snapshots

# How long to wait after the last edit before saving to local disk (ms). A short debounce so
# rapid typing doesn't mean a disk write per keystroke.
# DOC_SAVE_DEBOUNCE_MS=2000

# Even under continuous editing (where the debounce above would otherwise keep getting reset and
# never fire), force a save at least this often (ms) so unsaved changes never pile up for long.
# DOC_SAVE_MAX_DELAY_MS=15000

# Minimum time between GitHub pushes of the same workspace's snapshot (ms), to avoid hammering
# the GitHub API on every local save. A forced save always happens immediately regardless of this
# throttle when the last person leaves a workspace, and on server shutdown.
# DOC_GITHUB_SAVE_MIN_INTERVAL_MS=60000

# Set these two together to also back up every upload, and every workspace's live-document
# snapshot, to a GitHub repo via the Contents API. Leave both unset to skip GitHub entirely -
# uploads and document persistence still work, saved to local disk only (and won't survive a
# Render redeploy).
#   GITHUB_TOKEN  - a personal access token (fine-grained, scoped to just this repo, with
#                   "Contents: Read and write" permission) or a classic token with the "repo"
#                   scope. Create one at https://github.com/settings/tokens
#   GITHUB_REPO   - "owner/repo" of the backup repository, e.g. "yourname/helixnotes-uploads"
#   GITHUB_BRANCH - defaults to "main" if unset
# GITHUB_TOKEN=
# GITHUB_REPO=
# GITHUB_BRANCH=main
